{
	"name": "arbe/todo-hub",
	"description": "One central to-do list for WordPress, sorted by what needs doing first, with a simple API other plugins can add tasks to.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"bignall/wp-foundation": "^0.1.3"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.19",
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"TodoHub\\": "src/"
		},
		"files": [
			"src/functions.php"
		]
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "TodoHub\\Vendor\\",
			"classmap_prefix": "TodoHub_Vendor_",
			"packages": [
				"bignall/wp-foundation"
			],
			"delete_vendor_packages": true
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"strauss",
			"@composer dump-autoload"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		],
		"test": "phpunit"
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"platform-check": false,
		"sort-packages": true
	}
}
